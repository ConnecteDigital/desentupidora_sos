---
// Tag do Google Ads + conversões de WhatsApp e de ligação. Fica no <head> de todas as páginas.
// Valores em src/data/site.ts. Sem GOOGLE_TAG_ID, nada é renderizado.
// A conversão dispara SÓ no clique (link wa.me / api.whatsapp.com ou tel:), nunca no carregamento.
// Um único ouvinte delegado no document cobre todos os botões; não colocar onclick nos componentes.
import { GOOGLE_TAG_ID, ROTULO_CONVERSAO_WHATSAPP, ROTULO_CONVERSAO_LIGACAO } from '../data/site';

const id = GOOGLE_TAG_ID.trim();
const whats = ROTULO_CONVERSAO_WHATSAPP.trim() ? `${id}/${ROTULO_CONVERSAO_WHATSAPP.trim()}` : '';
const ligacao = ROTULO_CONVERSAO_LIGACAO.trim() ? `${id}/${ROTULO_CONVERSAO_LIGACAO.trim()}` : '';
---

{
  id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id, whats, ligacao }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id);
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var sendTo = null;
          if (/wa\.me|api\.whatsapp\.com/i.test(href)) sendTo = whats;
          else if (/^tel:/i.test(href)) sendTo = ligacao;
          if (!sendTo) return;
          var cidade = a.getAttribute('data-cidade') || document.body.getAttribute('data-cidade') || '';
          gtag('event', 'conversion', cidade ? { send_to: sendTo, cidade: cidade } : { send_to: sendTo });
        }, true);
      </script>
    </>
  )
}
