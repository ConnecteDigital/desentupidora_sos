---
import HeroBg from '../../../components/HeroBg.astro';
import Base from '../../../layouts/Base.astro';
import CtaButtons from '../../../components/CtaButtons.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { site, marca, SITE_URL } from '../../../data/site';
import { getServico } from '../../../data/servicos';
import { getCidade, type Cidade } from '../../../data/cidades';
import { cidadePath, blogCidadePath, postCidadePath, servicoCidadePath } from '../../../data/rotas';
import { breadcrumbSchema, businessId } from '../../../data/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blogCidades');
  return posts
    .map((post) => ({ post, cidade: getCidade(post.id.split('/')[0]) }))
    .filter(({ cidade }) => cidade.publicada)
    .map(({ post, cidade }) => ({
      params: { cidade: cidade.slug, post: post.id.split('/')[1] },
      props: { post, cidade },
    }));
}

interface Props {
  post: CollectionEntry<'blogCidades'>;
  cidade: Cidade;
}

const { post, cidade } = Astro.props;
const { Content } = await render(post);
const path = postCidadePath(post.id);
const servico = post.data.servico ? getServico(post.data.servico) : undefined;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: `Desentupidora ${cidade.em}`, path: cidadePath(cidade) },
  { name: 'Blog', path: blogCidadePath(cidade) },
  { name: post.data.titulo, path },
];
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.titulo,
  description: post.data.descricao,
  datePublished: post.data.data.toISOString(),
  mainEntityOfPage: new URL(path, SITE_URL + '/').href,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@id': businessId(cidade) },
};
---

<Base
  title={`${post.data.titulo} | Desentupidora SOS`}
  description={post.data.descricao}
  cidade={cidade}
  ogType="article"
  schema={[article, breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero has-bg">
    <HeroBg />
    <div class="container hero-center">
      <h1 style="text-transform:none">{post.data.titulo}</h1>
      <p class="hero-lead">{post.data.descricao}</p>
    </div>
  </section>
  <section class="section">
    <div class="container article">
      <div class="prose"><Content /></div>
      <div class="side-card" style="margin-top:40px">
        <h2>Precisa de desentupidora {cidade.em}?</h2>
        <p>
          {servico ? <>Veja o serviço de <a href={servicoCidadePath(cidade, servico)}>{servico.nome.toLowerCase()} {cidade.em}</a>. </> : null}
          {marca.horario}. {marca.chegada}.
        </p>
        <CtaButtons cidade={cidade} size="md" />
      </div>
    </div>
  </section>
  <CtaBand cidade={cidade} />
</Base>
