---
// Corpo da página de serviço (usado na versão geral e na versão por cidade).
import { Image } from 'astro:assets';
import FaqList from './FaqList.astro';
import { foto } from '../data/fotos';
import { marca } from '../data/site';
import type { Faq, Servico } from '../data/servicos';
import type { Cidade } from '../data/cidades';

interface Props {
  servico: Servico;
  cidade?: Cidade;
  faq: Faq[];
}
const { servico, cidade, faq } = Astro.props;
const fotoServico = foto(servico.slug);
// fotos pequenas ficam só no card; na página entram as de 800px ou mais
const img = fotoServico && fotoServico.width >= 800 ? fotoServico : undefined;
const nota = cidade?.notasServico?.[servico.slug];
---

{servico.intro.map((p) => <p>{p}</p>)}
{nota && <p>{nota}</p>}
{img && (
  <figure class="service-figure">
    <Image src={img} alt={`${servico.nome}: serviço da Desentupidora SOS`} widths={[480, 800, 1100]} sizes="(max-width: 960px) 100vw, 760px" />
  </figure>
)}

<h2>Quando chamar a desentupidora</h2>
<ul>{servico.sinais.map((s) => <li>{s}</li>)}</ul>

<h2>Como o serviço é feito</h2>
<ol>{servico.comoFazemos.map((s) => <li>{s}</li>)}</ol>

<h2>Atendimento da Desentupidora SOS{cidade ? ` ${cidade.em}` : ''}</h2>
<ul>
  <li>{marca.chegada}</li>
  <li>{marca.horario}, {marca.horarioDetalhe.toLowerCase()}</li>
  <li>{marca.emergencia}</li>
  <li>{marca.publico}: {marca.publicoDetalhe.toLowerCase()}</li>
</ul>

<h2>Perguntas frequentes sobre {servico.nome.toLowerCase()}</h2>
<FaqList items={faq} />
