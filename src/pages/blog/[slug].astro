---
import Base from '../../layouts/Base.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { site, marca, SITE_URL } from '../../data/site';
import { getServico } from '../../data/servicos';
import { servicoPath } from '../../data/rotas';
import { breadcrumbSchema, businessId } from '../../data/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;
const servico = post.data.servico ? getServico(post.data.servico) : undefined;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.data.titulo, path },
];
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.titulo,
  description: post.data.descricao,
  datePublished: post.data.data.toISOString(),
  mainEntityOfPage: new URL(path, SITE_URL + '/').href,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@id': businessId() },
};
---

<Base
  title={`${post.data.titulo} | Desentupidora SOS`}
  description={post.data.descricao}
  ogType="article"
  schema={[article, breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container article">
      <h1 style="text-transform:none">{post.data.titulo}</h1>
      <p class="hero-lead">{post.data.descricao}</p>
    </div>
  </section>
  <section class="section">
    <div class="container article">
      <div class="prose"><Content /></div>
      <div class="side-card" style="margin-top:40px">
        <h2>Precisa de ajuda agora?</h2>
        <p>
          {servico ? <>Conheça o serviço de <a href={servicoPath(servico)}>{servico.nome.toLowerCase()}</a>. </> : null}
          {marca.horario}. {marca.chegada}.
        </p>
        <CtaButtons size="md" />
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
