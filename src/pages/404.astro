---
import HeroBg from '../components/HeroBg.astro';
import { destaque } from '../data/texto';
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
---

<Base title="Página não encontrada | Desentupidora SOS" description="A página que você procura não existe." noindex>
  <section class="hero page-hero has-bg">
    <HeroBg />
    <div class="container hero-center">
      <span class="eyebrow">Erro 404</span>
      <h1 set:html={destaque(`Página não encontrada`)} />
      <p class="hero-lead">O endereço pode ter mudado. Escolha sua cidade para falar com a Desentupidora SOS ou volte ao <a href="/" style="color:#fff">início</a>.</p>
      <CtaButtons />
    </div>
  </section>
</Base>
